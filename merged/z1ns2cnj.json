                  }
                ],
                "script": [
                  {
                    "id": "naskh",
                    "label": "Naskh",
                    "writing_system": "Arabic"
                  }
                ],
                "label": "Scribal poem",
                "as_written": "وكم من كاتب الاشراف يبلى ويبقى الدهر / ما كتبت يداه / ولا تكتب بخطك غير شيا يسرك في القيامه / ان تراه",
                "note": [
                  "A poem by a scribe that asserts the fact that what is written outlives the scribe, and thus invites to write only pleasant texts"
                ]
              }
